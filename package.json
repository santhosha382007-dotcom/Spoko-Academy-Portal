{
  "name": "spoko-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3008",
    "backend": "node backend/server.js",
    "build": "vite build",
    "cap:sync": "npx cap sync android",
    "build:mobile": "vite build && npx cap sync android",
    "build:apk": "npm run build:mobile && cd android && gradlew.bat assembleDebug && cd ..",
    "electron": "electron .",
    "package:win": "electron-packager . \"Spoko Academy Portal\" --platform=win32 --arch=x64 --out=dist-electron --overwrite --ignore=\"(node_modules|src|android|backend|scripts|\\.git|dist-electron)\"",
    "build:win": "vite build && npm run package:win",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^4.4.168",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^44.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "json-server": "^0.17.4",
    "vite": "^5.4.21"
  }
}
